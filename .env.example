# ==============================================================================
# Environment configuration — COPY THIS FILE to `.env` and edit.
#
#   cp .env.example .env
#
# `.env` is gitignored. These values are loaded by app/config.py (pydantic).
# Everything has a safe default, so the app runs even with no .env at all —
# but you MUST set a real SECRET_KEY before deploying to production.
# ==============================================================================

# --- App identity (shown in the UI, browser title, PWA manifest) --------------
APP_NAME="Hyperstack"
APP_URL="http://localhost:8000"
APP_DESCRIPTION="A generic FastAPI + HTMX + Tailwind starter."

# --- Environment: "development" | "production" | "test" -----------------------
# Controls debug behavior, error pages, reload, and cookie security.
ENVIRONMENT="development"
DEBUG=true

# --- Security -----------------------------------------------------------------
# Used to sign session cookies. CHANGE THIS in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev-only-insecure-change-me"

# --- Database -----------------------------------------------------------------
# SQLite by default (zero setup). For Postgres, e.g.:
#   DATABASE_URL="postgresql+psycopg://user:pass@localhost:5432/mydb"
DATABASE_URL="sqlite:///./data/app.db"

# --- Server -------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8000

# --- Demo / seed credentials (used by scripts/seed.py) ------------------------
# The seed script creates this user so you can log in immediately in dev.
SEED_USER_EMAIL="admin@example.com"
SEED_USER_PASSWORD="password123"

# --- Feature flags ------------------------------------------------------------
# Toggle whole areas of the app on/off without code changes. Read these in
# templates via `settings.feature_*` and gate routes/services accordingly.
FEATURE_SIGNUPS=true
FEATURE_DARK_MODE=true
FEATURE_DASHBOARD=true

# --- Examples of integration keys you'll likely add later (leave blank) -------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
