# ==============================================================================
# Environment configuration — COPY THIS FILE to `.env` and edit.
#
#   cp .env.example .env
#
# `.env` is gitignored. These values are loaded by app/config.py (pydantic).
# Everything has a safe default, so the app runs even with no .env at all.
#
# OGTV Writer is an internal tool — there is no login. The SECRET_KEY below is
# only used to sign the cookie that carries one-shot flash messages.
# ==============================================================================

# --- App identity (shown in the UI, browser title, PWA manifest) --------------
APP_NAME="OGTV Writer"
APP_URL="http://localhost:8000"
APP_DESCRIPTION="OnlyGainsTV Writer — generate, organize, and export AI video scripts."
BRAND_NAME="OnlyGainsTV"

# Build stamp shown in the footer + /healthz (YYMMDD-HHMM, US Eastern). You don't set
# this by hand — `make deploy` bakes it into the Docker image. Leaving it UNSET locally
# is intentional: the app falls back to when the process started. (Don't add an empty
# BUILD_VERSION="" to your .env — in Docker it would override the image's baked stamp.)
#   BUILD_VERSION="260618-0921"

# --- Environment: "development" | "production" | "test" -----------------------
# Controls debug behavior, error pages, reload, and cookie security.
ENVIRONMENT="development"
DEBUG=true

# --- Security -----------------------------------------------------------------
# Signs the session cookie used for flash messages. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev-only-insecure-change-me"

# --- Database -----------------------------------------------------------------
# SQLite by default (zero setup). For Postgres, e.g.:
#   DATABASE_URL="postgresql+psycopg://user:pass@localhost:5432/mydb"
DATABASE_URL="sqlite:///./data/app.db"

# Apply pending migrations automatically on startup (dev convenience). Set to false
# in production and run `alembic upgrade head` as a deploy step.
AUTO_MIGRATE=true

# Root holding shoot folders for folder-based jobs (data/logline/<channel>/<shoot>/01.jpg).
SOURCE_ROOT="data/logline"

# Folder names to hide from the Shoots dashboard + job picker, matched at any depth
# under SOURCE_ROOT (e.g. a top-level "wip" channel and a nested "archive" grouping).
# Comma-separated.
SHOOTS_EXCLUDED_CHANNELS="wip,archive"

# --- Server -------------------------------------------------------------------
HOST="0.0.0.0"
# Port the app binds to (uvicorn / `make dev`, and inside the Docker container).
PORT=8000
# Docker host port only: docker-compose publishes the container on this port
# (http://localhost:${WEB_PORT}). Not read by the app — it's a compose variable.
WEB_PORT=9001

# --- Feature flags ------------------------------------------------------------
# Toggle whole areas of the app on/off without code changes. Read these in
# templates via `settings.feature_*` and gate routes/services accordingly.
FEATURE_DARK_MODE=true
FEATURE_DASHBOARD=true

# --- Gemini (powers the script generator) -------------------------------------
# Get an API key at https://aistudio.google.com. Generation is disabled until set.
# Tests mock Gemini, so this is only needed to actually run jobs.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# How many times the worker tries a job before giving up. Transient failures
# (rate-limit / network / 5xx) are retried; a content block fails immediately.
MAX_ATTEMPTS=3
