# ==============================================================================
# Environment configuration — COPY THIS FILE to `.env` and edit.
#
#   cp .env.example .env
#
# `.env` is gitignored. These values are loaded by app/config.py (pydantic).
# Everything has a safe default, so the app runs even with no .env at all.
#
# OGTV Writer is an internal tool — there is no login. The SECRET_KEY below is
# only used to sign the cookie that carries one-shot flash messages.
# ==============================================================================

# --- App identity (shown in the UI, browser title, PWA manifest) --------------
APP_NAME="OGTV Writer"
APP_URL="http://localhost:8000"
APP_DESCRIPTION="OnlyGainsTV Writer — generate, organize, and export AI video scripts."
BRAND_NAME="OnlyGainsTV"

# --- Environment: "development" | "production" | "test" -----------------------
# Controls debug behavior, error pages, reload, and cookie security.
ENVIRONMENT="development"
DEBUG=true

# --- Security -----------------------------------------------------------------
# Signs the session cookie used for flash messages. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev-only-insecure-change-me"

# --- Database -----------------------------------------------------------------
# SQLite by default (zero setup). For Postgres, e.g.:
#   DATABASE_URL="postgresql+psycopg://user:pass@localhost:5432/mydb"
DATABASE_URL="sqlite:///./data/app.db"

# --- Server -------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8000

# --- Feature flags ------------------------------------------------------------
# Toggle whole areas of the app on/off without code changes. Read these in
# templates via `settings.feature_*` and gate routes/services accordingly.
FEATURE_DARK_MODE=true
FEATURE_DASHBOARD=true

# --- Gemini (powers the script generator) -------------------------------------
# Get an API key at https://aistudio.google.com. Generation is disabled until set.
# Tests mock Gemini, so this is only needed to actually run jobs.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
